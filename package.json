{
    "name": "k8sdockside-longhorn-plugin",
    "version": "1.0.0",
    "private": true,
    "description": "The Longhorn plugin for K8s Dockside: volumes, replicas, nodes and disks, and what is wrong with them.",
    "license": "Apache-2.0",
    "author": "K8s Dockside",
    "repository": {
        "type": "git",
        "url": "https://github.com/k8sdockside/longhorn"
    },
    "type": "module",
